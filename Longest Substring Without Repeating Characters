#include <string.h>

int lengthOfLongestSubstring(char* s) {
    if (s == NULL || *s == '\0') {
        return 0;
    }

    // Array to store the last seen index of each ASCII character.
    // Initialized to -1 to represent that the character hasn't been seen yet.
    int lastSeen[128];
    for (int i = 0; i < 128; i++) {
        lastSeen[i] = -1;
    }

    int maxLength = 0;
    int start = 0; // Left boundary of the sliding window

    // Iterate through the string with 'end' as the right boundary
    for (int end = 0; s[end] != '\0'; end++) {
        unsigned char currentChar = (unsigned char)s[end];

        // If the character was seen inside the current window, move 'start'
        if (lastSeen[currentChar] >= start) {
            start = lastSeen[currentChar] + 1;
        }

        // Update the last seen position of the character
        lastSeen[currentChar] = end;

        // Calculate current window length and update maxLength
        int currentLength = end - start + 1;
        if (currentLength > maxLength) {
            maxLength = currentLength;
        }
    }

    return maxLength;
}
