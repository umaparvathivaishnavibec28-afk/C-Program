#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    int data;
    struct Node *next;
} Node;

int has_cycle(Node *head)
{
    Node *slow = head;
    Node *fast = head;

    while (fast != NULL && fast->next != NULL)
    {
        slow = slow->next;
        fast = fast->next->next;

        if (slow == fast)
        {
            return 1;
        }
    }

    return 0;
}

Node* create_node(int data)
{
    Node *newNode = (Node*)malloc(sizeof(Node));
    newNode->data = data;
    newNode->next = NULL;
    return newNode;
}

int main()
{
    Node *a, *b, *c;

    a = create_node(1);
    b = create_node(2);
    c = create_node(3);

    a->next = b;
    b->next = c;
    c->next = NULL;

    printf("%d\n", has_cycle(a));


    a = create_node(1);
    b = create_node(2);
    c = create_node(3);

    a->next = b;
    b->next = c;
    c->next = a;

    printf("%d\n", has_cycle(a));


    a = create_node(1);
    b = create_node(2);
    c = create_node(3);

    a->next = b;
    b->next = c;
    c->next = b;

    printf("%d\n", has_cycle(a));


    a = create_node(1);
    b = create_node(2);
    c = create_node(3);

    a->next = b;
    b->next = c;
    c->next = NULL;

    printf("%d\n", has_cycle(a));


    a = create_node(1);
    b = create_node(2);
    c = create_node(3);

    a->next = b;
    b->next = c;
    c->next = a;

    printf("%d\n", has_cycle(a));

    return 0;
}
