#include <limits.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))
#define MIN(a, b) ((a) < (b) ? (a) : (b))

double findMedianSortedArrays(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    // Always ensure nums1 is the smaller array to minimize binary search range
    if (nums1Size > nums2Size) {
        return findMedianSortedArrays(nums2, nums2Size, nums1, nums1Size);
    }
    
    int low = 0;
    int high = nums1Size;
    int totalLength = nums1Size + nums2Size;
    
    while (low <= high) {
        int partition1 = (low + high) / 2;
        int partition2 = (totalLength + 1) / 2 - partition1;
        
        // If partition1 is 0 it means nothing is on the left side from nums1, use INT_MIN
        int maxLeft1 = (partition1 == 0) ? INT_MIN : nums1[partition1 - 1];
        // If partition1 is equal to nums1Size, nothing is on the right side, use INT_MAX
        int minRight1 = (partition1 == nums1Size) ? INT_MAX : nums1[partition1];
        
        int maxLeft2 = (partition2 == 0) ? INT_MIN : nums2[partition2 - 1];
        int minRight2 = (partition2 == nums2Size) ? INT_MAX : nums2[partition2];
        
        // Check if we found the correct partition split
        if (maxLeft1 <= minRight2 && maxLeft2 <= minRight1) {
            // If total length is even, take average of the two middle values
            if (totalLength % 2 == 0) {
                return ((double)MAX(maxLeft1, maxLeft2) + MIN(minRight1, minRight2)) / 2.0;
            } else {
                // If total length is odd, the maximum of the left side is the median
                return (double)MAX(maxLeft1, maxLeft2);
            }
        } 
        // We are too far to the right in nums1, move left
        else if (maxLeft1 > minRight2) {
            high = partition1 - 1;
        } 
        // We are too far to the left in nums1, move right
        else {
            low = partition1 + 1;
        }
    }
    
    return 0.0;
}
