#include <stdlib.h>

/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
int* twoSum(int* nums, int numsSize, int target, int* returnSize) {
    // 1. Allocate memory for the output array containing 2 indices
    int* result = (int*)malloc(2 * sizeof(int));
    if (result == NULL) {
        *returnSize = 0;
        return NULL;
    }

    // 2. Iterate through the array to find the matching pair
    for (int i = 0; i < numsSize; i++) {
        for (int j = i + 1; j < numsSize; j++) {
            if (nums[i] + nums[j] == target) {
                result[0] = i;
                result[1] = j;
                *returnSize = 2; // Set the output size parameter
                return result;   // Return the pointer to the allocated memory
            }
        }
    }

    // 3. If no solution is found (though the problem guarantees exactly one)
    *returnSize = 0;
    free(result);
    return NULL;
}
