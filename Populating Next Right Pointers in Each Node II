class Solution {
public:
    Node* connect(Node* root) {
        if (!root) return nullptr;
        
        Node* curr = root; // Tracks the current level node
        
        while (curr != nullptr) {
            Node dummy(0);      // Dummy node for the next level
            Node* tail = &dummy; // Tail pointer to link nodes on the next level
            
            // Traverse the current level using the established 'next' pointers
            while (curr != nullptr) {
                if (curr->left) {
                    tail->next = curr->left;
                    tail = tail->next;
                }
                if (curr->right) {
                    tail->next = curr->right;
                    tail = tail->next;
                }
                curr = curr->next;
            }
            
            // Move to the first node of the next level
            curr = dummy.next;
        }
        
        return root;
    }
};
