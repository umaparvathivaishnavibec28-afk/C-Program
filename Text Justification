/**
 * Note: The returned array must be malloced, assume caller calls free().
 */
char** fullJustify(char** words, int wordsSize, int maxWidth, int* returnSize) {
    char** result = (char**)malloc(wordsSize * sizeof(char*));
    int resultCount = 0;
    int i = 0;
    
    while (i < wordsSize) {
        int j = i + 1;
        int lineLength = strlen(words[i]);
        
        // Pack words greedily
        while (j < wordsSize && lineLength + 1 + strlen(words[j]) <= maxWidth) {
            lineLength += 1 + strlen(words[j]);
            j++;
        }
        
        int numWords = j - i;
        int totalSpaces = maxWidth - (lineLength - (numWords - 1));
        
        char* line = (char*)malloc((maxWidth + 1) * sizeof(char));
        int currentPos = 0;
        
        // Case 1: Last line or line containing only one word (Left-justified)
        if (j == wordsSize || numWords == 1) {
            for (int k = i; k < j; k++) {
                int len = strlen(words[k]);
                strcpy(line + currentPos, words[k]);
                currentPos += len;
                if (k < j - 1) {
                    line[currentPos++] = ' ';
                }
            }
            while (currentPos < maxWidth) {
                line[currentPos++] = ' ';
            }
        } 
        // Case 2: Fully justified line
        else {
            int baseSpaces = totalSpaces / (numWords - 1);
            int extraSpaces = totalSpaces % (numWords - 1);
            
            for (int k = i; k < j; k++) {
                int len = strlen(words[k]);
                strcpy(line + currentPos, words[k]);
                currentPos += len;
                
                if (k < j - 1) {
                    int spacesToAdd = baseSpaces + (k - i < extraSpaces ? 1 : 0);
                    for (int s = 0; s < spacesToAdd; s++) {
                        line[currentPos++] = ' ';
                    }
                }
            }
        }
        
        line[currentPos] = '\0';
        result[resultCount++] = line;
        i = j;
    }
    
    *returnSize = resultCount;
    return result;
}
